<form class="al-form">
  <div class="al-form-group">
    <label for="light-select">{{localize "agnostic-light.controlPanel.selectLight"}}</label>
    <select id="light-select" style="width:100%;">
      {{#each models}}
        <option value="{{this.key}}" {{#if (eq this.key ../selectedLightKey)}}selected{{/if}}>
          {{localize this.name}}
        </option>
      {{/each}}
    </select>
  </div>

  <div class="al-form-group">
    <label for="al-color">{{localize "LIGHT.FIELDS.color.label"}}</label>
    <input type="color" id="al-color" name="color" value="{{selectedModel.color}}" />
  </div>

  <div class="al-form-group">
    <label for="al-simple-range">{{localize "agnostic-light.controlPanel.mapRange"}}</label>
    <div class="al-range-group">
      <input type="range" id="al-simple-range" min="0" max="{{radiusSliderMax}}" step="0.1" value="{{selectedModel.dim}}" />
      <span id="al-simple-range-value">{{selectedModel.dim}}</span>
    </div>
  </div>

  <div class="al-form-group">
    <label for="al-simple-angle">{{localize "agnostic-light.controlPanel.beamAngle"}}</label>
    <div class="al-range-group">
      <input type="range" id="al-simple-angle" min="0" max="360" step="1" value="{{selectedModel.angle}}" />
      <span id="al-simple-angle-value">{{selectedModel.angle}}</span>
    </div>
  </div>

  <div class="al-form-group">
    <label for="al-animation">{{localize "LIGHT.FIELDS.animation.label"}}</label>
    <select id="al-animation" name="animation"></select>
  </div>

  <p class="al-form-note">{{localize "agnostic-light.controlPanel.simpleHint"}}</p>

  <input type="hidden" id="al-max-radius" name="maxLightRadius" value="{{maxLightRadiusValue}}" />
  <input type="hidden" id="al-intensity" name="intensity" value="{{selectedModel.intensity}}" />
  <input type="hidden" id="al-dim" name="dim" value="{{selectedModel.dim}}" />
  <input type="hidden" id="al-bright" name="bright" value="{{selectedModel.bright}}" />
  <input type="hidden" id="al-angle" name="angle" value="{{selectedModel.angle}}" />

  <div class="al-actions">
    <button type="button" class="al-cancel-button">{{localize "agnostic-light.controlPanel.cancelEdits"}}</button>
    <button type="button" class="al-submit-button">{{localize "agnostic-light.controlPanel.save"}}</button>
  </div>
</form>
